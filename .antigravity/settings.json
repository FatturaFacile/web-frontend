{
  "compactThresholdPercent": 50,
  "maxBashOutputChars": 15000,
  "permissions": {
    "deny": [
      "Read(./**/node_modules/**)",
      "Read(./**/dist/**)",
      "Read(./**/.angular/**)",
      "Read(./**/test-results/**)",
      "Read(./**/*.lock)",
      "Read(./**/*-lock.*)",
      "Read(./**/.env*)",
      "Read(./**/auth.json)"
    ]
  }
}
