# Ignore list shared by every AI tool of this repository (gitignore syntax).
# Copy of: .aiignore .claudeignore .agyignore .copilotignore. Keep the four files identical.

# Dependencies and build output
node_modules/
dist/
.angular/
test-results/
playwright-report/
pnpm-lock.yaml
package-lock.json
yarn.lock

# Secrets and local data (never read)
.env
.env.*
auth.json
certs/
*.pem
*.key
*.pfx
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.log
logs/
coverage/
.idea/
.vs/

# Generated and minified files (token sinks)
*.min.js
*.min.css
*.map
*.css.map
*.pdf
*.zip
*.png
*.jpg
*.jpeg
*.svg
