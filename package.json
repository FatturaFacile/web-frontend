{
  "name": "fatturafacile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "ng": "ng",
    "start": "node scripts/ng-env.mjs serve",
    "start:local": "node scripts/ng-env.mjs serve --configuration local",
    "build": "node scripts/ng-env.mjs build",
    "watch": "node scripts/ng-env.mjs build --watch --configuration development",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "e2e": "playwright test",
    "api:coverage": "node scripts/api-coverage.mjs ../web-api/docs/api/openapi.json src/app",
    "api:contract": "node scripts/api-contract-check.mjs ../web-api/docs/api/openapi.json src/app",
    "api:generate": "openapi-typescript ../web-api/docs/api/openapi.json -o src/app/core/api/generated/schema.d.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "agent:sandbox": "node scripts/agent-sandbox.mjs",
    "agent:docker": "node scripts/agent-sandbox.mjs --container"
  },
  "dependencies": {
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/service-worker": "22.2.4",
    "@ant-design/icons-angular": "^22.1.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@ngrx/signals": "^22.0.1",
    "ng-zorro-antd": "^22.1.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.5",
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@angular/language-service": "22.2.4",
    "@angular/localize": "^22.2.4",
    "@angular/platform-browser-dynamic": "22.2.4",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "less": "^4.9.1",
    "only-allow": "^1.2.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
