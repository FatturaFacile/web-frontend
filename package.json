{
  "name": "fatturafacile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "ng": "ng",
    "start": "node scripts/ng-env.mjs serve",
    "start:local": "pnpm start --configuration local",
    "build": "node scripts/ng-env.mjs build",
    "watch": "node scripts/ng-env.mjs build --watch --configuration development",
    "test": "vitest run",
    "test:ci": "node scripts/test-ci-sharded.mjs",
    "e2e": "playwright test",
    "e2e:a11y": "playwright test -c playwright.a11y.config.ts",
    "storybook": "ng run fatturafacile:storybook",
    "build-storybook": "ng run fatturafacile:build-storybook",
    "api:coverage": "node scripts/api-coverage.mjs ../web-api/docs/api/openapi.json src/app",
    "api:contract": "node scripts/api-contract-check.mjs ../web-api/docs/api/openapi.json src/app",
    "api:generate": "openapi-typescript ../web-api/docs/api/openapi.json -o src/app/core/api/generated/schema.d.ts",
    "tokens:build": "node scripts/build-design-tokens.mjs",
    "tokens:check": "node scripts/build-design-tokens.mjs --check",
    "tokens:sync": "node scripts/build-design-tokens.mjs --sync",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "agent:sandbox": "node scripts/agent-sandbox.mjs",
    "agent:docker": "node scripts/agent-sandbox.mjs --container"
  },
  "dependencies": {
    "@angular/cdk": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@angular/service-worker": "22.3.0",
    "@ant-design/icons-angular": "^22.1.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@ngrx/signals": "^22.0.1",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "laravel-echo": "^2.6.3",
    "ng-zorro-antd": "^22.2.1",
    "pdfjs-dist": "^6.5.438",
    "pusher-js": "^8.6.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.7",
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@angular/language-service": "22.3.0",
    "@angular/localize": "^22.3.0",
    "@angular/platform-browser-dynamic": "22.3.0",
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.9",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/angular": "^10.6.9",
    "@types/node": "^26.6.11",
    "@vitest/coverage-v8": "5.1.2",
    "angular-eslint": "^22.8.0",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "less": "^4.9.1",
    "only-allow": "^1.2.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "storybook": "^10.6.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
