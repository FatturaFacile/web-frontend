# Copy to .env to override the env/<configuration>.env values on this machine (.env is git-ignored).
# Variables set in the shell or in CI take precedence over both.

# API base URL used by the app: a same-origin path (/api/v1) or an absolute URL
# API_BASE_URL=/api/v1

# Backend that the dev server proxies /api and /sanctum to (npm run start, npm run start:local)
# API_PROXY_TARGET=http://localhost:8000

# true pre-fills the login form with the demo account credentials
# DEMO_MODE=false
